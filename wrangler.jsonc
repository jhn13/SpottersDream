{
  // Cloudflare Workers config: serves the site from public/, runs /api/* in worker/index.js,
  // and runs the alerts job every 2 minutes.
  "name": "spottersdream",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": {
    "SUPABASE_URL": "https://mgpuyvbmmzvjzsvpyfhw.supabase.co",
    "VAPID_SUBJECT": "https://spottersdream.joshnaylor.workers.dev"
  },
  // SUPABASE_SECRET_KEY is a secret: add it in the Cloudflare dashboard (Settings -> Variables and Secrets).
  "keep_vars": true,
  "observability": { "enabled": true }
}
