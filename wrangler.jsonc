{
  // Cloudflare Workers config: serves the site from public/ and runs /api/* in worker/index.js
  "name": "spottersdream",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
